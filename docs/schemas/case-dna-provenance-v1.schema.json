{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mysterylogic.com/schemas/case-dna-provenance-v1.schema.json",
  "title": "Mystery Logic Case DNA Provenance v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "source_snapshot",
    "claims",
    "review"
  ],
  "properties": {
    "schema_version": {
      "const": "case_dna_provenance_v1"
    },
    "case_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "source_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provenance",
        "rights_status",
        "ingestion_policy"
      ],
      "properties": {
        "provenance": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "source_reference": {
          "type": "string",
          "maxLength": 2000
        },
        "rights_status": {
          "enum": [
            "owned",
            "public_domain",
            "government_public_record",
            "licensed",
            "user_owned",
            "analysis_only",
            "unknown"
          ]
        },
        "ingestion_policy": {
          "enum": [
            "full_text_allowed",
            "permitted_excerpts_only",
            "metadata_and_analysis_only",
            "prohibited_pending_review"
          ]
        },
        "snapshot_hash": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200
        },
        "snapshot_date": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 80
        }
      }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_dna_path",
          "status",
          "materiality"
        ],
        "properties": {
          "case_dna_path": {
            "type": "string",
            "minLength": 2,
            "maxLength": 500
          },
          "status": {
            "enum": [
              "source_supported",
              "abstracted_from_source",
              "editorial_inference",
              "unknown",
              "not_applicable"
            ]
          },
          "materiality": {
            "enum": [
              "critical",
              "supporting",
              "editorial"
            ]
          },
          "source_locator": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 2000
          },
          "support_note": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 2000
          },
          "reviewer_note": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 2000
          }
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "review_status",
        "reviewed_at"
      ],
      "properties": {
        "review_status": {
          "enum": [
            "not_reviewed",
            "needs_review",
            "approved",
            "rejected"
          ]
        },
        "reviewed_at": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 80
        },
        "reviewer": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 240
        },
        "notes": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 4000
        }
      }
    }
  }
}
