{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mysterylogic.com/schemas/corpus-ingestion-job-v1.schema.json",
  "title": "Mystery Logic Corpus Ingestion Job v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "job_id",
    "source",
    "constraints",
    "required_outputs"
  ],
  "properties": {
    "schema_version": {
      "const": "corpus_ingestion_job_v1"
    },
    "job_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 220
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "title",
        "source_family",
        "source_type",
        "source_reference",
        "rights_status",
        "ingestion_policy",
        "raw_text_retained"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 180
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "source_family": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "source_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "source_reference": {
          "type": "string",
          "minLength": 3,
          "maxLength": 2000
        },
        "source_locator": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1000
        },
        "rights_status": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "ingestion_policy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "raw_text_retained": {
          "type": "boolean"
        },
        "target_pattern_tags": {
          "type": "array",
          "maxItems": 40,
          "items": {
            "type": "string",
            "maxLength": 120
          }
        },
        "rights_evidence_reference": {
          "type": "string",
          "minLength": 3,
          "maxLength": 2000
        },
        "rights_verified_date": {
          "type": "string",
          "minLength": 8,
          "maxLength": 80
        }
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "retain_raw_text",
        "copy_distinctive_plot",
        "fabricate_unknowns",
        "critical_claims_need_locators",
        "output_language"
      ],
      "properties": {
        "retain_raw_text": {
          "type": "boolean"
        },
        "copy_distinctive_plot": {
          "type": "boolean"
        },
        "fabricate_unknowns": {
          "type": "boolean"
        },
        "critical_claims_need_locators": {
          "type": "boolean"
        },
        "output_language": {
          "type": "string",
          "minLength": 2,
          "maxLength": 20
        },
        "notes": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "string",
            "maxLength": 800
          }
        }
      }
    },
    "required_outputs": {
      "type": "array",
      "minItems": 2,
      "maxItems": 10,
      "uniqueItems": true,
      "items": {
        "enum": [
          "case_dna_v1",
          "case_dna_provenance_v1",
          "extraction_notes",
          "rights_review_note"
        ]
      }
    }
  }
}
