{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mysterylogic.com/schemas/corpus-source-grounding-audit-v1.schema.json",
  "title": "Mystery Logic Corpus Source Grounding Audit v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "audit_id",
    "auditor_context_id",
    "independent_review",
    "can_approve",
    "items",
    "summary"
  ],
  "properties": {
    "schema_version": {
      "const": "corpus_source_grounding_audit_v1"
    },
    "audit_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 240
    },
    "auditor_context_id": {
      "type": "string",
      "minLength": 2,
      "maxLength": 240
    },
    "independent_review": {
      "const": false
    },
    "can_approve": {
      "const": false
    },
    "created_at": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 80
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "status",
          "source_access",
          "rights_evidence_access",
          "findings"
        ],
        "properties": {
          "case_id": {
            "type": "string",
            "minLength": 3,
            "maxLength": 180
          },
          "status": {
            "enum": [
              "ready_for_independent_review",
              "needs_extractor_repair",
              "blocked_source_access"
            ]
          },
          "source_access": {
            "type": "boolean"
          },
          "rights_evidence_access": {
            "type": "boolean"
          },
          "critical_claims_checked": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 500
            },
            "maxItems": 200
          },
          "findings": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "severity",
                "code",
                "message"
              ],
              "properties": {
                "severity": {
                  "enum": [
                    "info",
                    "warn",
                    "repair"
                  ]
                },
                "code": {
                  "type": "string",
                  "minLength": 2,
                  "maxLength": 100
                },
                "message": {
                  "type": "string",
                  "minLength": 2,
                  "maxLength": 3000
                },
                "case_dna_path": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "maxLength": 500
                },
                "source_reference": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "maxLength": 2000
                }
              }
            }
          },
          "repairs_applied": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 2000
            },
            "maxItems": 100
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total",
        "ready",
        "needs_repair",
        "blocked",
        "independent_review_still_required"
      ],
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "ready": {
          "type": "integer",
          "minimum": 0
        },
        "needs_repair": {
          "type": "integer",
          "minimum": 0
        },
        "blocked": {
          "type": "integer",
          "minimum": 0
        },
        "independent_review_still_required": {
          "const": true
        }
      }
    }
  }
}
