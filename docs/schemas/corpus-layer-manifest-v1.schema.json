{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mysterylogic.com/schemas/corpus-layer-manifest-v1.schema.json",
  "title": "Mystery Logic Corpus Layer Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_id",
    "layers"
  ],
  "properties": {
    "schema_version": {
      "const": "corpus_layer_manifest_v1"
    },
    "manifest_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 180
    },
    "layers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "layer_id",
          "status",
          "path",
          "retrieval_allowed"
        ],
        "properties": {
          "layer_id": {
            "type": "string",
            "minLength": 2,
            "maxLength": 160
          },
          "status": {
            "enum": [
              "approved_legacy",
              "approved_reviewed",
              "needs_review",
              "candidate",
              "blocked"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "retrieval_allowed": {
            "type": "boolean"
          },
          "shadow_only": {
            "type": "boolean",
            "default": false
          },
          "note": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 2000
          }
        }
      }
    }
  }
}
